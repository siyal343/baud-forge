{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BaudForge",
  "version": "1.0.0",
  "identifier": "dev.baudforge.app",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BaudForge — Hardware Engineering Workstation",
        "width": 1280,
        "height": 760,
        "minWidth": 720,
        "minHeight": 450,
        "maximized": true,
        "url": "index.html",
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "BaudForge",
    "shortDescription": "Serial monitor, protocol dissector and fault-injection rig"
  }
}
