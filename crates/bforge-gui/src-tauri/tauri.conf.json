{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BaudForge",
  "version": "0.7.0",
  "identifier": "dev.baudforge.app",
  "build": {
    "frontendDist": "../../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BaudForge",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "url": "desktop.html",
        "decorations": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "BaudForge",
    "shortDescription": "Serial monitor, protocol dissector and fault-injection rig"
  }
}
