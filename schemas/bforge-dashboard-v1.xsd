<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://baudforge.dev/schema/dashboard/v1"
           xmlns="http://baudforge.dev/schema/dashboard/v1"
           elementFormDefault="qualified">

  <!-- =========================================================================
       BaudForge Declarative XML Dashboard Schema (v1.0)
       Enables IntelliSense, auto-completion, and strict validation in IDEs.
       ========================================================================= -->

  <!-- Direction enum -->
  <xs:simpleType name="DirectionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="horizontal"/>
      <xs:enumeration value="vertical"/>
      <xs:enumeration value="row"/>
      <xs:enumeration value="column"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Button variant enum -->
  <xs:simpleType name="ButtonVariantType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="primary"/>
      <xs:enumeration value="danger"/>
      <xs:enumeration value="ghost"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Group of all child nodes (layouts and widgets) -->
  <xs:group name="DashboardNodeGroup">
    <xs:choice>
      <xs:element name="grid" type="GridLayoutType"/>
      <xs:element name="stack" type="StackLayoutType"/>
      <xs:element name="card" type="CardLayoutType"/>
      <xs:element name="split" type="SplitLayoutType"/>
      <xs:element name="gauge" type="GaugeWidgetType"/>
      <xs:element name="numeric-display" type="NumericDisplayWidgetType"/>
      <xs:element name="chart" type="ChartWidgetType"/>
      <xs:element name="led" type="LedWidgetType"/>
      <xs:element name="switch" type="SwitchWidgetType"/>
      <xs:element name="button" type="ButtonWidgetType"/>
      <xs:element name="slider" type="SliderWidgetType"/>
      <xs:element name="log-grid" type="LogGridWidgetType"/>
    </xs:choice>
  </xs:group>

  <!-- Layout Containers -->
  <xs:complexType name="GridLayoutType">
    <xs:sequence>
      <xs:group ref="DashboardNodeGroup" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="columns" type="xs:positiveInteger" default="2"/>
    <xs:attribute name="cols" type="xs:positiveInteger"/>
    <xs:attribute name="gap" type="xs:integer" default="12"/>
    <xs:attribute name="title" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="StackLayoutType">
    <xs:sequence>
      <xs:group ref="DashboardNodeGroup" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="direction" type="DirectionType" default="vertical"/>
    <xs:attribute name="dir" type="DirectionType"/>
    <xs:attribute name="gap" type="xs:integer" default="12"/>
    <xs:attribute name="title" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="CardLayoutType">
    <xs:sequence>
      <xs:group ref="DashboardNodeGroup" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="title" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="SplitLayoutType">
    <xs:sequence>
      <xs:group ref="DashboardNodeGroup" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="direction" type="DirectionType" default="horizontal"/>
    <xs:attribute name="dir" type="DirectionType"/>
    <xs:attribute name="gap" type="xs:integer" default="8"/>
    <xs:attribute name="title" type="xs:string"/>
  </xs:complexType>

  <!-- Zones for Gauge -->
  <xs:complexType name="ZonesType">
    <xs:attribute name="low" type="xs:decimal"/>
    <xs:attribute name="high" type="xs:decimal"/>
    <xs:attribute name="warn-color" type="xs:string"/>
    <xs:attribute name="warnColor" type="xs:string"/>
    <xs:attribute name="fault-color" type="xs:string"/>
    <xs:attribute name="faultColor" type="xs:string"/>
  </xs:complexType>

  <!-- Widgets -->
  <xs:complexType name="GaugeWidgetType">
    <xs:sequence>
      <xs:element name="zones" type="ZonesType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="source" type="xs:string" use="required"/>
    <xs:attribute name="src" type="xs:string"/>
    <xs:attribute name="min" type="xs:decimal" default="0"/>
    <xs:attribute name="max" type="xs:decimal" default="100"/>
    <xs:attribute name="unit" type="xs:string"/>
    <xs:attribute name="label" type="xs:string"/>
    <xs:attribute name="zone-low" type="xs:decimal"/>
    <xs:attribute name="zone-high" type="xs:decimal"/>
    <xs:attribute name="warn-color" type="xs:string"/>
    <xs:attribute name="fault-color" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="NumericDisplayWidgetType">
    <xs:attribute name="source" type="xs:string" use="required"/>
    <xs:attribute name="src" type="xs:string"/>
    <xs:attribute name="label" type="xs:string"/>
    <xs:attribute name="unit" type="xs:string"/>
    <xs:attribute name="precision" type="xs:integer"/>
  </xs:complexType>

  <xs:complexType name="ChartWidgetType">
    <xs:attribute name="source" type="xs:string" use="required"/>
    <xs:attribute name="src" type="xs:string"/>
    <xs:attribute name="min" type="xs:decimal"/>
    <xs:attribute name="max" type="xs:decimal"/>
    <xs:attribute name="color" type="xs:string"/>
    <xs:attribute name="height" type="xs:integer" default="140"/>
    <xs:attribute name="duration-ms" type="xs:integer" default="10000"/>
    <xs:attribute name="durationMs" type="xs:integer"/>
  </xs:complexType>

  <xs:complexType name="LedWidgetType">
    <xs:attribute name="source" type="xs:string" use="required"/>
    <xs:attribute name="src" type="xs:string"/>
    <xs:attribute name="label" type="xs:string"/>
    <xs:attribute name="on-color" type="xs:string"/>
    <xs:attribute name="onColor" type="xs:string"/>
    <xs:attribute name="off-color" type="xs:string"/>
    <xs:attribute name="offColor" type="xs:string"/>
    <xs:attribute name="pulse" type="xs:boolean" default="false"/>
  </xs:complexType>

  <xs:complexType name="SwitchWidgetType">
    <xs:attribute name="target" type="xs:string" use="required"/>
    <xs:attribute name="dest" type="xs:string"/>
    <xs:attribute name="label" type="xs:string"/>
    <xs:attribute name="on-value" type="xs:string"/>
    <xs:attribute name="onValue" type="xs:string"/>
    <xs:attribute name="off-value" type="xs:string"/>
    <xs:attribute name="offValue" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="ButtonWidgetType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="command" type="xs:string" use="required"/>
        <xs:attribute name="cmd" type="xs:string"/>
        <xs:attribute name="label" type="xs:string"/>
        <xs:attribute name="param" type="xs:string"/>
        <xs:attribute name="arg" type="xs:string"/>
        <xs:attribute name="variant" type="ButtonVariantType" default="primary"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="SliderWidgetType">
    <xs:attribute name="target" type="xs:string" use="required"/>
    <xs:attribute name="dest" type="xs:string"/>
    <xs:attribute name="min" type="xs:decimal" default="0"/>
    <xs:attribute name="max" type="xs:decimal" default="100"/>
    <xs:attribute name="step" type="xs:decimal" default="1"/>
    <xs:attribute name="label" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="LogGridWidgetType">
    <xs:attribute name="source" type="xs:string"/>
    <xs:attribute name="src" type="xs:string"/>
    <xs:attribute name="limit" type="xs:integer" default="50"/>
    <xs:attribute name="height" type="xs:integer" default="200"/>
  </xs:complexType>

  <!-- Root Element: bforge-dashboard -->
  <xs:element name="bforge-dashboard">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="DashboardNodeGroup" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="title" type="xs:string" default="BaudForge Dashboard"/>
      <xs:attribute name="version" type="xs:string" default="1.0"/>
      <xs:attribute name="refresh-ms" type="xs:integer"/>
      <xs:attribute name="refreshMs" type="xs:integer"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
